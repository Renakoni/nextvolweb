---
type Name = "arrow" | "download" | "external" | "github" | "chevron" | "copy" | "check" | "refresh";
interface Props {
  name: Name;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className = "" } = Astro.props;
---

<svg
  class={`icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "arrow" && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === "download" && <path d="M12 4v11m-5-5 5 5 5-5M5 20h14" />}
  {name === "external" && <path d="M8 16 17 7m-8 0h8v8" />}
  {name === "chevron" && <path d="m7 10 5 5 5-5" />}
  {name === "copy" && <path d="M9 9h10v11H9zM5 15V4h10" />}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === "refresh" && <path d="M19 12a7 7 0 1 1-2.05-4.95M19 4v4h-4" />}
  {
    name === "github" && (
      <path
        fill="currentColor"
        stroke="none"
        d="M12 2.6a9.4 9.4 0 0 0-2.97 18.32c.47.09.64-.2.64-.45v-1.6c-2.62.57-3.17-1.26-3.17-1.26-.43-1.09-1.05-1.38-1.05-1.38-.85-.58.07-.57.07-.57.94.07 1.44.97 1.44.97.84 1.44 2.2 1.02 2.73.78.09-.61.33-1.02.6-1.26-2.09-.24-4.29-1.05-4.29-4.65 0-1.03.37-1.87.97-2.53-.1-.24-.42-1.2.09-2.5 0 0 .79-.25 2.59.97a9 9 0 0 1 4.71 0c1.8-1.22 2.59-.97 2.59-.97.51 1.3.19 2.26.09 2.5.6.66.97 1.5.97 2.53 0 3.61-2.2 4.4-4.3 4.64.34.29.64.87.64 1.75v2.6c0 .25.17.55.65.45A9.4 9.4 0 0 0 12 2.6Z"
      />
    )
  }
</svg>
