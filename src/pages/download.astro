---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { project, releases, issues, downloadTitle } from "../data/site";
const title = downloadTitle.title;
const longest = Math.max(...title.map((line) => [...line].length));
---

<Base
  page="download"
  title="下载 NextVol · Android 安装包"
  description="下载 NextVol 的 Android 安装包，查看版本、大小、校验值和安装步骤。安装包发布在 GitHub Releases。"
>
  <header class="chrome">
    <a class="brand" href="/">
      <img src="/images/app-icon-64.webp" width="32" height="32" alt="" />
      <span class="brand-name">NextVol</span>
      <span class="brand-sub">Android 小说阅读器</span>
    </a>
    <div class="chrome-actions">
      <a class="chrome-link" href="/">
        <span class="chrome-back">回到首页</span>
      </a>
      <a class="chrome-link" href={project} target="_blank" rel="noopener noreferrer">
        <Icon name="github" size={18} />
        <span>GitHub</span>
      </a>
    </div>
  </header>

  <main id="main">
    <section class="vol vol-cover dl-hero" aria-labelledby="dl-title">
      <div class="jacket">
        <div class="jacket-art" aria-hidden="true">
          <span class="sun"></span>
          <svg class="hill" viewBox="0 0 1600 1000" preserveAspectRatio="none">
            <path
              class="hill-fill"
              d="M0 1000V585C150 455 300 400 455 455s300 300 530 318c210 16 400-110 615-205v442Z"
            />
            <path
              class="hill-line"
              d="M0 735c180-110 360-140 545-75s330 220 560 214c200-6 350-120 495-170"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
        <div class="art dl-art">
          <figure class="screen dl-screen" aria-hidden="true">
            <img src="/images/library-440.webp" width="440" height="782" alt="" decoding="async" />
          </figure>
          <article class="release" data-release data-state="static" aria-labelledby="release-name">
            <header class="release-head">
              <h2 class="release-name" id="release-name">NextVol <span>Android 版</span></h2>
              <span class="release-badge" data-r="badge" hidden>预览版</span>
            </header>
            <p class="release-status" data-r="status" aria-live="polite">
              安装包发布在 GitHub Releases。
            </p>
            <dl class="release-table">
              <div data-row="version">
                <dt>版本</dt>
                <dd class="release-version">
                  <span data-r="version">以发布页为准</span>
                  <button class="release-retry" type="button" data-retry hidden>
                    <Icon name="refresh" size={16} />
                    重新查询
                  </button>
                </dd>
              </div>
              <div data-row="date"><dt>发布日期</dt><dd data-r="date"></dd></div>
              <div data-row="file"><dt>安装包</dt><dd data-r="file"></dd></div>
              <div data-row="size"><dt>大小</dt><dd data-r="size"></dd></div>
              <div data-row="sha">
                <dt>SHA-256</dt>
                <dd class="release-sha">
                  <code data-r="sha"></code>
                  <button class="copy" type="button" data-copy aria-label="复制完整 SHA-256 校验值">
                    <Icon name="copy" size={16} />
                    <span data-copy-label>复制</span>
                  </button>
                </dd>
              </div>
              <div><dt>系统要求</dt><dd>Android 7.0 及以上</dd></div>
              <div><dt>许可</dt><dd>Apache-2.0 开源</dd></div>
            </dl>
          </article>
        </div>
        <div class="title-block">
          <h1 class="vtitle" id="dl-title" style={`--len:${longest};--cols:${title.length}`}>
            {title.map((line) => <span class="vline">{line}</span>)}
          </h1>
          <p class="spine" aria-hidden="true">
            <span class="roundel"><Icon name="download" size={24} /></span>
            <span class="spine-code">NV-DL</span>
          </p>
        </div>
      </div>
      <div class="obi">
        <div class="obi-inner">
          <div class="obi-copy">
            <p class="obi-lead" data-r="lead">装进手机，下一卷随时接着读。</p>
            <p class="obi-fine" data-r="fine">安装包来自 GitHub Releases，可在发布页核对版本与校验值。</p>
          </div>
          <div class="obi-actions">
            <a class="btn btn-primary btn-xl" href={releases} data-r="button" target="_blank" rel="noopener noreferrer">
              <span class="btn-stack">
                <span data-r="label">前往发布页</span>
                <small data-r="meta">GitHub Releases</small>
              </span>
              <span class="ic-page"><Icon name="external" size={22} /></span>
              <span class="ic-file"><Icon name="download" size={22} /></span>
            </a>
            <a class="btn btn-quiet" href={project} data-r="secondary" target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={18} />
              <span data-r="secondary-label">在 GitHub 关注</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="dl-guide" aria-labelledby="guide-title">
      <div class="dl-guide-inner">
        <h2 id="guide-title" class="guide-title">装好之后，<br />三步开读。</h2>
        <ol class="steps">
          <li>
            <span class="step-num" aria-hidden="true">1</span>
            <h3>允许安装</h3>
            <p>首次安装 APK 时，按系统提示，允许浏览器或文件管理器“安装未知应用”。</p>
          </li>
          <li>
            <span class="step-num" aria-hidden="true">2</span>
            <h3>把书放进来</h3>
            <p>在书架导入本地 EPUB、TXT，目录会自动解析。</p>
          </li>
          <li>
            <span class="step-num" aria-hidden="true">3</span>
            <h3>添加书源</h3>
            <p>在「书源」里通过链接或文件导入阅读 3.0 文本书源，然后搜索、找书。</p>
          </li>
        </ol>
        <div class="platforms" aria-label="平台状态">
          <p class="platforms-title">其他平台</p>
          <ul>
            <li><span>Android</span><b class="is-on">可用 · 7.0 及以上</b></li>
            <li><span>鸿蒙原生版</span><b>尚未开发</b></li>
            <li><span>iOS</span><b>尚未开发</b></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="dl-footer">
    <p>NextVol · Apache-2.0 开源项目</p>
    <nav aria-label="项目链接">
      <a href="/">首页</a>
      <a href={project} target="_blank" rel="noopener noreferrer">源码</a>
      <a href={releases} target="_blank" rel="noopener noreferrer">发布记录</a>
      <a href={issues} target="_blank" rel="noopener noreferrer">问题反馈</a>
      <a href="/licenses/fonts-OFL.txt">字体许可</a>
    </nav>
  </footer>

  <script>
    import "../scripts/release";
  </script>
</Base>
